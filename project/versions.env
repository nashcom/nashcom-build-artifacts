# Default versions and download URLs. Override any of these with
# `docker run -e CURL_VERSION=... ...` (or edit this file) to build a
# different combination without touching the build scripts.

CURL_VERSION="${CURL_VERSION:-8.21.0}"
OPENSSL_VERSION="${OPENSSL_VERSION:-4.0.1}"
ZLIB_VERSION="${ZLIB_VERSION:-1.3.2}"

CURL_URL="${CURL_URL:-https://curl.se/download/curl-${CURL_VERSION}.tar.xz}"
OPENSSL_RELEASES="https://github.com/openssl/openssl/releases/download"
OPENSSL_TAG="openssl-${OPENSSL_VERSION}"
OPENSSL_URL="${OPENSSL_URL:-${OPENSSL_RELEASES}/${OPENSSL_TAG}/${OPENSSL_TAG}.tar.gz}"
ZLIB_URL="${ZLIB_URL:-https://zlib.net/fossils/zlib-${ZLIB_VERSION}.tar.gz}"

# Expected SHA-256 of each tarball -- leave empty to skip verification (a
# WARN is logged), fill in to make a checksum mismatch a hard failure.
# Find the real value on the project's own download page whenever you pin
# a version here -- never guess or copy one from an unrelated source:
#   curl:    https://curl.se/download.html (sha256 listed per release, plus a .asc signature)
#   openssl: https://openssl-library.org/source/ (sha256 listed per release)
#   zlib:    https://zlib.net/ (sha256 listed per release)
CURL_SHA256="${CURL_SHA256:-aa1b66a70eace83dc624508745646c08ae561de512ab403adffb93ac87fc72e6}"
OPENSSL_SHA256="${OPENSSL_SHA256:-2db3f3a0d6ea4b59e1f094ace2c8cd536dffb87cdc39084c5afa1e6f7f37dd09}"
ZLIB_SHA256="${ZLIB_SHA256:-bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16}"
